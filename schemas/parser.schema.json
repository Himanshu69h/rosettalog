{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rosettalog.example/schemas/parser.schema.json",
  "title": "RosettaLog Parser Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "state",
    "source_format",
    "envelope",
    "templates",
    "unmapped_policy",
    "created_from",
    "verify_report_ref"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "state": {
      "type": "string",
      "enum": ["draft", "verified", "active", "drifting", "superseded"]
    },
    "source_format": { "type": "string" },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header_regex", "timestamp_format", "tz"],
      "properties": {
        "header_regex": { "type": ["string", "null"] },
        "timestamp_format": { "type": "string" },
        "tz": { "type": "string" }
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "regex", "fields", "event_class", "activity"],
        "properties": {
          "id": { "type": "string" },
          "regex": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "ocsf_path", "confidence"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "ocsf_path": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
              }
            }
          },
          "event_class": { "type": "string" },
          "activity": { "type": "string" }
        }
      }
    },
    "unmapped_policy": {
      "type": "string",
      "enum": ["retain", "mask", "quarantine"]
    },
    "created_from": { "type": "string" },
    "verify_report_ref": { "type": ["string", "null"] }
  }
}
